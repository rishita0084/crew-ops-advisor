# Copy this to .env. Without a .env the console silently falls back to recorded
# fixtures instead of calling the backend -- the page still works, which is what makes
# that easy to miss.
#
# VITE_USE_MOCKS=false  -> call the live engine (what you want)
# VITE_USE_MOCKS=true   -> browse the console with no backend running
#
# 127.0.0.1 rather than localhost is deliberate: on Windows `localhost` can resolve to
# IPv6 ::1 while uvicorn listens on IPv4, and the symptom is a page that loads perfectly
# and answers nothing.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCKS=false
