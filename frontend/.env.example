# Point the console at the backend. Set VITE_USE_MOCKS=true to run the UI standalone.
# Use 127.0.0.1 rather than localhost: on Windows `localhost` may resolve to ::1 while
# uvicorn listens on IPv4, which fails silently at the fetch layer.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCKS=false
